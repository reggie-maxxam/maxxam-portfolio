      "parameters": {
        "person": "YOUR_LINKEDIN_PERSON_URN",
        "text": "={{ $json.hook }}\n\n{{ $json.body }}\n\n{{ $json.cta }}",
        "additionalFields": {}
      },
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "YOUR - LinkedIn"
        }
      }
    },
