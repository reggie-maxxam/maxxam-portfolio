{
  "name": "MAXXAM AI — LinkedIn Poster",
  "nodes": [
    {
      "name": "Schedule Trigger",
      "notes": "Runs Mon-Fri at 8:00 AM. Adjust cron to match your preferred post time.",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -880,
        128
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "name": "Read Content Calendar",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        -656,
        128
      ],
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "Content_Calendar",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/YOUR_GOOGLE_SHEET_ID/edit#gid=0"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "YOUR - Google Sheets"
        }
      }
    },
    {
      "name": "Filter: Approved LinkedIn Posts for Today",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        -448,
        128
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $json.status }}",
              "rightValue": "approved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-002",
              "leftValue": "={{ $json.platform }}",
              "rightValue": "LinkedIn",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-003",
              "leftValue": "={{ $json.schedule_date }}",
              "rightValue": "={{ $now.format('yyyy-MM-dd') }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Has Image?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -224,
        128
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-image",
              "leftValue": "={{ $json.image_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Download Image",
      "notes": "Downloads image asset for posts that include an image.",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "onError": "continueErrorOutput",
      "position": [
        0,
        0
      ],
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $json.image_url }}"
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "YOUR - Google Drive"
        }
      }
    },
    {
      "name": "Post to LinkedIn (with image)",
      "notes": "Replace YOUR_LINKEDIN_PERSON_URN with your LinkedIn person URN or organization URN for company page.",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "onError": "continueErrorOutput",
      "position": [
        224,
        0
      ],
      "parameters": {
        "person": "YOUR_LINKEDIN_PERSON_URN",
        "text": "={{ $('Filter: Approved LinkedIn Posts for Today').item.json.hook }}\n\n{{ $('Filter: Approved LinkedIn Posts for Today').item.json.body }}\n\n{{ $('Filter: Approved LinkedIn Posts for Today').item.json.cta }}",
        "shareMediaCategory": "IMAGE",
        "additionalFields": {}
      },
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "YOUR - LinkedIn"
        }
      }
    },
    {
      "name": "Post to LinkedIn (text only)",
